# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- LiveKit (agent/agent.py) — required to run a real call session --------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Deepgram STT (agent/agent.py) — required to run a real call session --
DEEPGRAM_API_KEY=

# --- Moss semantic retrieval (db/moss_client.py) --------------------------
# Get these from https://portal.usemoss.dev. Without both set, db/moss_client.py
# runs in STUB_MODE (in-memory, keyword-overlap "search") so the rest of the
# stack stays runnable.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# --- TTS (agent/agent.py) --------------------------------------------------
# "edge-tts" (free, no key, default — Kokoro isn't wired up yet, see
# agent/agent.py's _synthesize_kokoro docstring for why) or "kokoro" once it is.
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-AriaNeural
# KOKORO_MODEL_PATH= / KOKORO_SERVER_URL=   # TODO: fill in once self-host path is decided

# --- LLM for follow-up generation (agent/agent.py) -------------------------
# Without this set, agent.py uses a templated follow-up instead of a real LLM
# call, so the loop stays runnable without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- agent runtime (agent/agent.py) -----------------------------------------
CALLS_DIR=calls
DB_PATH=data/app.db
FALLBACK_TIMEOUT_S=1.2

# --- exposing the web app (signup/app.py) ----------------------------------
# The app has no user accounts: it lists patient names and mints LiveKit
# tokens that cost money to redeem. Local requests are unrestricted, but
# anything arriving through a tunnel (ngrok, cloudflared) must pass HTTP Basic
# auth with these. Leave DEMO_PASSWORD empty and remote requests get 503 —
# exposing the app without setting one does nothing, by design.
DEMO_USER=demo
DEMO_PASSWORD=

# Leave this off. debug=True serves the Werkzeug debugger, which is an
# interactive Python console to anyone who reaches an error page.
FLASK_DEBUG=
